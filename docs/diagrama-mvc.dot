// Figura 2 do relatório: organização MVC, persistência e classes de resultado.
digraph MVC {
  rankdir=TB;
  nodesep=0.3;
  ranksep=0.6;
  dpi=200;
  fontname="Helvetica";
  node [shape=record, fontname="Helvetica", fontsize=11, style=filled, fillcolor="#FFFFFF", margin="0.10,0.06"];
  edge [fontname="Helvetica", fontsize=10, labeldistance=1.5, labelangle=-25];

  JanelaPrincipal [label="{JanelaPrincipal  (V)|- controller : PlanejamentoController\l- painelParticipantes, painelDespesas,\l   painelResumo, painelSimulador\l|+ atualizarTudo() : void\l- salvar() : void\l- abrir() : void\l}", fillcolor="#F3E5F5"];
  Paineis [label="{PainelParticipantes, PainelDespesas,\nPainelResumo, PainelSimulador  (V)|- controller : PlanejamentoController\l|~ atualizar() : void\l}", fillcolor="#F3E5F5"];

  PlanejamentoController [label="{PlanejamentoController  (C)|- planejamento : Planejamento\l- fabricaRepositorio : Function\<File,\l      RepositorioPlanejamento\>\l|+ cadastrarParticipante(codigo, nome, orcamento : String) : void\l+ incluirDespesa(tipo, descricao, valor : String, ...) : void\l+ excluirDespesa(indice : int) : void\l+ resumo() : Resumo\l+ simular() : ResultadoSimulacao\l+ salvar(arquivo : File) : void\l+ carregar(arquivo : File) : void\l}", fillcolor="#E0F2F1"];

  Planejamento [label="{Planejamento  (M)|(ver Figura 1)\l}", fillcolor="#E8F0FE"];
  Repositorio [label="{\<\<interface\>\>\nRepositorioPlanejamento||+ salvar(p : Planejamento) : void\l+ carregar() : Planejamento\l}", fillcolor="#FFF3E0"];
  Arquivo [label="{ArquivoPlanejamentoRepository|- arquivo : File\l|+ salvar(p : Planejamento) : void\l+ carregar() : Planejamento\l}", fillcolor="#FFF3E0"];
  Simulador [label="{Simulador  (M)||+ simular(p : Planejamento)\l      : ResultadoSimulacao\l\l}", fillcolor="#E8F0FE"];
  Resumo [label="{Resumo  (M)|- linhas : List\<Resumo.Linha\>\l- despesas : List\<Despesa\>\l- custoTotal : long\l|+ calcular(participantes, despesas)\l      : Resumo\l+ getLinha(codigo : int) : Linha\l}", fillcolor="#E8F0FE"];

  {rank=same; Planejamento; Repositorio; Simulador;}
  {rank=same; Arquivo; Resumo;}

  JanelaPrincipal -> Paineis [dir=both, arrowtail=diamond, arrowhead=none, taillabel="1", headlabel="4"];
  JanelaPrincipal -> PlanejamentoController [arrowhead=vee, headlabel="1"];
  Paineis -> PlanejamentoController [arrowhead=vee, headlabel="1"];
  PlanejamentoController -> Planejamento [arrowhead=vee, headlabel="1", label=" modelo "];
  PlanejamentoController -> Repositorio [arrowhead=vee, style=dashed, label=" usa "];
  PlanejamentoController -> Simulador [arrowhead=vee, style=dashed, label=" usa "];
  Arquivo -> Repositorio [arrowhead=empty, style=dashed];
  Planejamento -> Resumo [arrowhead=vee, style=dashed, label=" cria "];
  Simulador -> Resumo [arrowhead=vee, style=dashed, label=" calcula "];
}
